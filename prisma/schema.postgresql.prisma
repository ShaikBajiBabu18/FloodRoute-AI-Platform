// FloodRoute AI Prisma PostgreSQL Schema (Production / Docker)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  name           String
  phone          String?
  role           String          @default("CITIZEN")
  isActive       Boolean         @default(true)
  lastActive     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  reports        FloodReport[]
  savedLocations SavedLocation[]
  routeRequests  RouteRequest[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model SavedLocation {
  id           String   @id @default(uuid())
  userId       String
  name         String
  locationName String
  latitude     Float
  longitude    Float
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([latitude, longitude])
}

model FloodReport {
  id              String      @id @default(uuid())
  reportCode      String      @unique
  userId          String?
  hazardType      String
  severity        String
  waterLevel      String
  latitude        Float
  longitude       Float
  locationName    String
  district        String?
  state           String?
  description     String
  imageUrl        String?
  status          String      @default("PENDING")
  adminNotes      String?
  verifiedAt      DateTime?
  verifiedBy      String?
  upvotes         Int         @default(0)
  isDemo          Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  images          FloodImage[]
  aiAnalysis      AIAnalysis?

  @@index([latitude, longitude])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
  @@index([locationName])
}

model FloodImage {
  id           String      @id @default(uuid())
  reportId     String
  imageUrl     String
  fileName     String
  fileSize     Int?
  mimeType     String?
  createdAt    DateTime    @default(now())

  report       FloodReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model AIAnalysis {
  id                  String      @id @default(uuid())
  reportId            String      @unique
  floodDetected       Boolean
  estimatedSeverity   String
  roadVisibility      String
  vehicleAccessibility String
  confidence          Int
  waterCoveragePercent Float?
  dominantColor       String?
  explanation         String
  disclaimer          String      @default("AI-assisted estimate. Not an official disaster determination.")
  analyzedAt          DateTime    @default(now())

  report              FloodReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([estimatedSeverity])
  @@index([floodDetected])
}

model WeatherRecord {
  id               String   @id @default(uuid())
  latitude         Float
  longitude        Float
  locationName     String
  temperatureC     Float
  feelsLikeC       Float
  humidityPercent  Int
  windSpeedKmh     Float
  windDirectionDeg Float?
  pressureHpa      Float?
  cloudCoverPercent Int?
  rainfallMm       Float
  visibilityKm     Float?
  condition        String
  weatherRisk      String
  source           String
  isDemo           Boolean  @default(false)
  timestamp        DateTime @default(now())

  @@index([latitude, longitude])
  @@index([timestamp])
}

model WeatherAlert {
  id           String   @id @default(uuid())
  title        String
  description  String
  severity     String
  area         String
  latitude     Float?
  longitude    Float?
  source       String   @default("IMD")
  startTime    DateTime
  expiryTime   DateTime
  isActive     Boolean  @default(true)
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([severity])
  @@index([isActive])
}

model DisasterAlert {
  id           String   @id @default(uuid())
  title        String
  description  String
  severity     String
  source       String
  sourceLabel  String
  locationName String
  state        String?
  district     String?
  latitude     Float
  longitude    Float
  radiusKm     Float    @default(15)
  startTime    DateTime
  expiryTime   DateTime
  isActive     Boolean  @default(true)
  isOfficial   Boolean  @default(true)
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([latitude, longitude])
  @@index([severity])
  @@index([isActive])
  @@index([source])
}

model RoadCondition {
  id                     String    @id @default(uuid())
  roadName               String
  locationName           String
  condition              String
  severity               String
  reason                 String
  latitude               Float
  longitude              Float
  startLatitude          Float?
  startLongitude         Float?
  endLatitude            Float?
  endLongitude           Float?
  source                 String    @default("Municipal Traffic Control")
  isOfficial             Boolean   @default(true)
  startTime              DateTime  @default(now())
  expectedResolutionTime DateTime?
  updatedBy              String?
  isDemo                 Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([latitude, longitude])
  @@index([condition])
  @@index([severity])
  @@index([updatedAt])
}

model RouteRequest {
  id            String        @id @default(uuid())
  userId        String?
  originLat     Float
  originLng     Float
  originName    String?
  destLat       Float
  destLng       Float
  destName      String?
  avoidFlooded  Boolean       @default(true)
  avoidHighRisk Boolean       @default(true)
  preferSafer   Boolean       @default(true)
  createdAt     DateTime      @default(now())

  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  results       RouteResult[]

  @@index([userId])
  @@index([createdAt])
}

model RouteResult {
  id                 String       @id @default(uuid())
  requestId          String
  title              String
  distanceKm         Float
  durationMinutes    Float
  floodRisk          String
  weatherRisk        String
  overallRisk        String
  hazardsCount       Int          @default(0)
  officialAlertsCount Int         @default(0)
  riskScore          Int
  riskReasonsJson    String
  geometryJson       String
  stepsJson          String?
  isRecommended      Boolean      @default(false)
  createdAt          DateTime     @default(now())

  request            RouteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([overallRisk])
}

model EmergencyResource {
  id            String   @id @default(uuid())
  name          String
  category      String
  address       String
  city          String?
  state         String?
  phone         String?
  latitude      Float
  longitude     Float
  isOpen        Boolean  @default(true)
  notes         String?
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([latitude, longitude])
  @@index([category])
  @@index([city])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String?
  action    String
  entity    String
  entityId  String
  details   String?
  ipAddress String?
  timestamp DateTime @default(now())

  admin     User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@index([entity])
  @@index([timestamp])
}
