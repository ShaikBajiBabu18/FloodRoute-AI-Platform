# FloodRoute AI Environment Configuration Template
NODE_ENV=development
PORT=5000

# Database Configuration
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/floodroute?schema=public"

# Authentication Secrets
JWT_SECRET="replace_with_your_super_secret_jwt_key"
JWT_EXPIRES_IN="7d"

# Microservices & Frontend Production Connection
AI_SERVICE_URL="http://127.0.0.1:8000"
CLIENT_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"
VITE_API_URL="https://YOUR-RENDER-BACKEND.onrender.com"
VITE_WS_URL="https://YOUR-RENDER-BACKEND.onrender.com"

# Map & Routing Providers
MAP_STYLE_URL="https://demotiles.maplibre.org/style.json"
MAPTILER_API_KEY=""
MAPBOX_ACCESS_TOKEN=""
ROUTING_API_URL="https://router.project-osrm.org"
GEOCODING_API_URL="https://nominatim.openstreetmap.org"

# Weather & Alerts Integration
OPEN_METEO_API_URL="https://api.open-meteo.com/v1"
IMD_API_URL=""
IMD_API_KEY=""
CWC_API_URL=""
NDMA_API_URL=""

# Features & Configurable Demo Location
DEMO_MODE=true
DEMO_LOCATION_NAME="Velachery Basin, Chennai"
DEMO_LATITUDE=12.9805
DEMO_LONGITUDE=80.2195
VITE_DEMO_LOCATION_NAME="Velachery Basin, Chennai"
VITE_DEMO_LATITUDE=12.9805
VITE_DEMO_LONGITUDE=80.2195
ENABLE_AI_SERVICE=true
FRESHNESS_THRESHOLD_MINUTES=60
