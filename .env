# FloodRoute AI Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# Local zero-config default: SQLite file
DATABASE_URL="file:./dev.db"
# For Docker / PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/floodroute?schema=public"

# Authentication
JWT_SECRET="floodroute_jwt_secret_key_india_disaster_2026_secure"
JWT_EXPIRES_IN="7d"

# Microservices & Frontends
AI_SERVICE_URL="http://127.0.0.1:8000"
CLIENT_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

# Real Map & Routing Services (Configurable, with OpenStreetMap/OSRM defaults)
# Free open styles: Demotiles / OpenStreetMap raster/vector tiles
MAP_STYLE_URL="https://demotiles.maplibre.org/style.json"
MAPTILER_API_KEY=""
MAPBOX_ACCESS_TOKEN=""
ROUTING_API_URL="https://router.project-osrm.org"
GEOCODING_API_URL="https://nominatim.openstreetmap.org"

# Official Weather & Disaster API Endpoints
OPEN_METEO_API_URL="https://api.open-meteo.com/v1"
IMD_API_URL=""
IMD_API_KEY=""
CWC_API_URL=""
NDMA_API_URL=""

# Operational Flags
DEMO_MODE=true
ENABLE_AI_SERVICE=true
FRESHNESS_THRESHOLD_MINUTES=60
